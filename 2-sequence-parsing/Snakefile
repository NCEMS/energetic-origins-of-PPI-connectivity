from pathlib import Path

LOCAL_CONFIG  = config["sequence_parsing"]

WORK_DIR      = Path(workflow.basedir)
DATA_DIR1     = LOCAL_CONFIG["input_dir"]
DATA_DIR2     = config["data_dir"]
OUTPUT_PREFIX = config["output_prefix"]
OUTPUT_DIR    = str(WORK_DIR / LOCAL_CONFIG["output_dir"])
ORGANISM_TAG  = config["organism_label"]
MAP_FILE      = str(Path(DATA_DIR1) / LOCAL_CONFIG["map_file"])

rule all:
    input:
        f"{OUTPUT_DIR}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-nodes-centrality-seqs.csv",
        f"{OUTPUT_DIR}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-nodes-centrality-seqs-DeepTMHMM.csv"

rule add_sequences:
    input:
        nodes = f"{DATA_DIR1}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-nodes-centrality.csv",
        fasta = f"{DATA_DIR2}/orf_trans.fasta"
    conda:
        f"{WORK_DIR}/env/add-sequence-info.yml"
    params:
        output_prefix = OUTPUT_PREFIX,
        output_dir    = OUTPUT_DIR,
        id_mappings   = {MAP_FILE},
        organism_tag  = {ORGANISM_TAG}
    output:
        f"{OUTPUT_DIR}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-nodes-centrality-seqs.csv"
    shell:
        f"""
        python {WORK_DIR}/python-scripts/add-sequence-info.py \
        --nodes         {input.nodes} \
        --fasta         {input.fasta} \
        --output_prefix {params.output_prefix} \
        --output_dir    {params.output_dir} \
        --organism_tag  {params.organism_tag} \
        --id_mappings   {params.id_mappings}
        """

rule add_DeepTMHMM:
    input:
        nodes = f"{OUTPUT_DIR}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-nodes-centrality-seqs.csv",
        preds = "DeepTMHMM-runs/s288c-results/all-predictions-s288c.3line"
    conda:
        f"{WORK_DIR}/env/add-DeepTMHMM-info.yml"
    params:
        output_prefix = OUTPUT_PREFIX,
        output_dir    = OUTPUT_DIR,
        organism_tag  = ORGANISM_TAG
    output:
        f"{OUTPUT_DIR}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-nodes-centrality-seqs-DeepTMHMM.csv"
    shell:
        f"""
        python {WORK_DIR}/python-scripts/add-DeepTMHMM-info.py \
        --nodes         {input.nodes} \
        --DeepTMHMM     {input.preds} \
        --output_prefix {params.output_prefix} \
        --output_dir    {params.output_dir} \
        --organism_tag  {params.organism_tag}
        """
