from pathlib import Path

LOCAL_CONFIG   = config["predict_PTMs"]

INPUT_NODES    = LOCAL_CONFIG["input_nodes"]
WORK_DIR       = Path(workflow.basedir)
OUTPUT_PREFIX  = config["output_prefix"]
OUTPUT_DIR     = WORK_DIR / LOCAL_CONFIG["output_dir"]
ORGANISM_TAG   = config["organism_label"]
TOKENIZER_PATH = Path(LOCAL_CONFIG["tokenizer_path"])
MODEL_PATH     = Path(LOCAL_CONFIG["gpt_model_path"])
PTM_NAMES      = [ "Acetylation_K", "Amidation_V", "Formylation_K", "Glutarylation_K", "Glutathionylation_C",
                   "Hydroxylation_K", "Hydroxylation_P", "Malonylation_K", "Methylation_K", "Methylation_R",
                   "N-linked_Glycosylation_N", "O-linked_Glycosylation_ST", "Phosphorylation_ST", "Phosphorylation_Y",
                   "Succinylation_K", "Sumoylation_K", "S-nitrosylation_C", "S-palmitoylation_C", "Ubiquitination_K"]

rule all:
    input:
        f"{OUTPUT_DIR}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-{OUTPUT_SUFFIX}.pkl",
        f"{OUTPUT_DIR}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-PTMGPT2-predictions.csv",
        f"{OUTPUT_DIR}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-PTMGPT2-predictions-processed.csv"


rule predict_PTMs:
    input:
        INPUT_NODES
    conda:
        "env/ptmgpt2.yml"
    params:
        output_prefix = OUTPUT_PREFIX,
        output_dir    = str(OUTPUT_DIR),
        organism_tag  = ORGANISM_TAG,
        tokenizer     = str(TOKENIZER_PATH),
        model_dir     = str(MODEL_PATH)
    output:
        expand(f"{OUTPUT_DIR}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-{{ptm}}_part{{part}}.csv", ptm=PTM_NAMES, part=[0, 1])
    shell:
        f"""
        python {WORK_DIR}/python-scripts/run-PTMGPT2-parallel.py \
        --nodes          {{input}} \
        --output_dir     {{params.output_dir}} \
        --output_prefix  {{params.output_prefix}} \
        --organism_tag   {{params.organism_tag}} \
        --tokenizer_path {{params.tokenizer}} \
        --gpt_model_path {{params.model_dir}}
        """


rule combine_PTMs:
    input:
        expand(f"{OUTPUT_DIR}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-{{ptm}}_part{{part}}.csv", ptm=PTM_NAMES, part=[0, 1])
    output:
        expand(f"{OUTPUT_DIR}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-{{ptm}}.csv", ptm=PTM_NAMES)
    run:
        import pandas as pd
        import re
        from collections import defaultdict

        parts = defaultdict(list)
        for f in input:
            ptm = re.sub(r"_part[01]\.csv$", "", os.path.basename(f))
            parts[ptm].append(f)

        for out_file in output:
            ptm = os.path.splitext(os.path.basename(out_file))[0]
            part_files = sorted(parts[ptm])
            dfs = [pd.read_csv(pf) for pf in part_files]
            pd.concat(dfs).to_csv(out_file, index=False)


rule merge_all_PTMs:
    input:
        expand(f"{OUTPUT_DIR}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-{{ptm}}.csv", ptm=PTM_NAMES)
    output:
        f"{OUTPUT_DIR}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-PTMGPT2-predictions.csv"
    shell:
        "head -n 1 {input[0]} > {output} && tail -n +2 -q {input} >> {output}"


rule process_PTMs:
    input:
        ptms = f"{OUTPUT_DIR}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-PTMGPT2-predictions.csv",
        nodes = INPUT_NODES
    conda:
        "env/ptmgpt2.yml"
    params:
        output_prefix = OUTPUT_PREFIX,
        output_suffix = OUTPUT_SUFFIX,
        output_dir    = str(OUTPUT_DIR),
        organism_tag  = ORGANISM_TAG        
    output:
        f"{OUTPUT_DIR}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-PTMGPT2-predictions-processed.csv",
        f"{OUTPUT_DIR}/{OUTPUT_PREFIX}-{ORGANISM_TAG}-{OUTPUT_SUFFIX}.pkl"
    shell:
        f"""
        python {WORK_DIR}/python-scripts/process-PTMGPT2.py \
        --input_file    {{input.ptms}} \
        --nodes         {{input.nodes}} \
        --output_dir    {{params.output_dir}} \
        --output_prefix {{params.output_prefix}} \
        --output_suffix {{params.output_suffix}} \
        --organism_tag  {{params.organism_tag}}
        """
