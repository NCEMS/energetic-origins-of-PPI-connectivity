from pathlib import Path

LOCAL_CONFIG = config["Rosetta_scoring"]

WORK_DIR = Path(workflow.basedir)

INPUT_NODES   = Path(LOCAL_CONFIG["input_nodes"])
OUTPUT_PREFIX = config["output_prefix"]
OUTPUT_SUFFIX = LOCAL_CONFIG["output_suffix"]
ORGANISM_TAG  = config["organism_label"]
OUTPUT_DIR    = (WORK_DIR / LOCAL_CONFIG["output_dir"])
SCORE_DIR     = (OUTPUT_DIR / "scores")
FINAL_NODES   = (OUTPUT_DIR / f"{OUTPUT_PREFIX}-{ORGANISM_TAG}-{OUTPUT_SUFFIX}.pkl")
NPROCS        = LOCAL_CONFIG["nprocessors"]
RELAX_EXEC    = LOCAL_CONFIG["relax_executable"]
NSTRUC        = LOCAL_CONFIG["n_structures"]


# =====================================================================
# Determine Rosetta operating mode
# =====================================================================

#
#     mode: "run"
#     mode: "existing"
#     mode: "dummy"
#
#     default: "dummy"

if "mode" in LOCAL_CONFIG:
    MODE = str(
        LOCAL_CONFIG["mode"]
    ).strip().lower()

else:
    MODE = (
        "dummy"
        if LOCAL_CONFIG.get(
            "dummy_run",
            False,
        ) is True
        else "run"
    )

VALID_MODES = {"run", "existing", "dummy",}

if MODE not in VALID_MODES:
    raise ValueError(
        "Rosetta_scoring.mode must be one of: "
        "'run', 'existing', or 'dummy'. "
        f"Received: {MODE!r}"
    )


print(f"Rosetta scoring mode: {MODE}")


# =====================================================================
# Mode-specific completion signals
# =====================================================================

RUN_READY = (
    SCORE_DIR
    / ".run_scores_ready"
)

EXISTING_READY = (
    SCORE_DIR
    / ".existing_scores_ready"
)

DUMMY_READY = (
    SCORE_DIR
    / ".dummy_scores_ready"
)


if MODE == "run":
    SCORE_READY = RUN_READY

elif MODE == "existing":
    SCORE_READY = EXISTING_READY

else:
    SCORE_READY = DUMMY_READY


# =====================================================================
# Dummy Rosetta columns
# =====================================================================

ROSETTA_DUMMY_COLUMNS = [
    "Rosetta_total_score_0001",
    "Rosetta_total_score_0002",
    "Rosetta_total_score_0003",
    "Rosetta_total_score_0004",
    "Rosetta_total_score_0005",
    "Rosetta_total_score_0006",
    "Rosetta_total_score_0007",
    "Rosetta_total_score_0008",
    "Rosetta_total_score_0009",
    "Rosetta_total_score_0010",
    "Rosetta_best_total_score",
    "Rosetta_best_pose_index",
    "Rosetta_scores_available",
    "Rosetta_dummy_run",
]


# =====================================================================
# Overall goal
# =====================================================================

rule all:
    input:
        str(SCORE_READY),
        str(FINAL_NODES)


# =====================================================================
# Dummy mode
# =====================================================================

if MODE == "dummy":

    rule write_dummy_Rosetta_scores:
        input:
            input_nodes=INPUT_NODES

        conda:
            "env/run-Rosetta.yml"

        output:
            done_signal=str(DUMMY_READY),
            output_nodes=str(FINAL_NODES)

        params:
            nstruc=NSTRUC,
            mode=MODE

        shell:
            f"""
            mkdir -p {SCORE_DIR}

            python {WORK_DIR}/python-scripts/write-dummy-Rosetta-scores.py \
                --nodes {{input.input_nodes}} \
                --output_nodes {{output.output_nodes}} \
                --done_signal {{output.done_signal}} \
                --nstruct {{params.nstruc}}
            """


# =====================================================================
# Run Rosetta mode
# =====================================================================

elif MODE == "run":

    rule run_Rosetta:
        input:
            input_nodes=INPUT_NODES

        conda:
            "env/run-Rosetta.yml"

        params:
            output_prefix=OUTPUT_PREFIX,
            output_dir=SCORE_DIR,
            organism_tag=ORGANISM_TAG,
            nprocessors=NPROCS,
            relax_exec=RELAX_EXEC,
            nstruc=NSTRUC,
            mode=MODE

        output:
            ready=str(RUN_READY)

        shell:
            f"""
            mkdir -p {{params.output_dir}}

            rm -f {{output.ready}}

            python {WORK_DIR}/python-scripts/run-Rosetta.py \
                --nodes {{input.input_nodes}} \
                --output_dir {{params.output_dir}} \
                --output_prefix {{params.output_prefix}} \
                --organism_tag {{params.organism_tag}} \
                --nprocessors {{params.nprocessors}} \
                --relax_executable {{params.relax_exec}} \
                --nstruct {{params.nstruc}}

            touch {{output.ready}}
            """


# =====================================================================
# Existing Rosetta results mode
# =====================================================================

elif MODE == "existing":

    # Discover the existing Rosetta structures when the DAG is built.
    #
    # Expected filenames look like:
    #
    #     AT1G80590_0001.pdb
    #     AT1G80590_0002.pdb
    #     ...
    #     AT1G80590_0010.pdb

    EXISTING_PDBS = sorted(
        str(path)
        for path in SCORE_DIR.glob("*.pdb")
    )

    rule validate_existing_Rosetta_scores:
        input:
            pdbs=EXISTING_PDBS

        output:
            ready=str(EXISTING_READY)

        params:
            score_dir=SCORE_DIR,
            nstruc=NSTRUC,
            mode=MODE

        run:
            import re

            score_dir = Path(
                params.score_dir
            )

            pdb_files = [
                Path(path)
                for path in input.pdbs
            ]

            if not pdb_files:
                raise ValueError(
                    "Rosetta mode is 'existing', but no "
                    f"PDB files were found in:\n"
                    f"{score_dir}"
                )

            # Expected final naming convention:
            #
            # AT1G80590_0007.pdb
            #
            filename_pattern = re.compile(
                r".+_\d{4}\.pdb$"
            )

            unexpected_files = [
                path.name
                for path in pdb_files
                if not filename_pattern.fullmatch(
                    path.name
                )
            ]

            if unexpected_files:
                preview = "\n".join(
                    unexpected_files[:20]
                )

                raise ValueError(
                    "Found Rosetta PDB files with unexpected "
                    "filenames.\n\n"
                    "Expected filenames such as:\n"
                    "AT1G80590_0007.pdb\n\n"
                    "Examples of unexpected files:\n"
                    f"{preview}"
                )

            print(
                f"Found {len(pdb_files):,} existing "
                f"Rosetta PDB files in:"
            )

            print(
                f"  {score_dir}"
            )

            print(
                "Existing Rosetta results passed "
                "basic validation."
            )

            Path(
                output.ready
            ).touch()


# =====================================================================
# Extract Rosetta scores
#
# Used for both:
#
#     mode: run
#     mode: existing
#
# Dummy mode bypasses this rule.
# =====================================================================

if MODE in {"run", "existing"}:

    rule add_scores_to_nodes:
        input:
            input_nodes=INPUT_NODES,
            input_done_signal=str(SCORE_READY)

        conda:
            "env/run-Rosetta.yml"

        params:
            output_prefix=OUTPUT_PREFIX,
            output_suffix=OUTPUT_SUFFIX,
            input_dir=SCORE_DIR,
            organism_tag=ORGANISM_TAG,
            output_dir=OUTPUT_DIR,
            nstruc=NSTRUC,
            mode=MODE

        output:
            str(FINAL_NODES)

        shell:
            f"""
            python {WORK_DIR}/python-scripts/add-Rosetta-scores.py \
                --nodes {{input.input_nodes}} \
                --input_dir {{params.input_dir}} \
                --output_dir {{params.output_dir}} \
                --output_prefix {{params.output_prefix}} \
                --output_suffix {{params.output_suffix}} \
                --organism_tag {{params.organism_tag}} \
                --nstruct {{params.nstruc}}
            """
